@{
    ViewData["Title"] = "Ẩn Trình — Hành trình bí ẩn";
    Layout = "_Layout";
}

<style>
    body {
        background-color: #0a0a0a;
        color: #ffffff;
        background-image: radial-gradient(circle at center, #1a1a2e 0%, #000000 100%);
        height: 100vh;
    }

    *, *::before, *::after {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
    }

    :root {
        --primary: #c8a96e;
        --primary-glow: rgba(200, 169, 110, 0.4);
        --accent: #7eb8d4;
        --accent-glow: rgba(126, 184, 212, 0.3);
        --fog-1: rgba(180, 210, 230, 0.06);
        --fog-2: rgba(200, 169, 110, 0.04);
        --surface: rgba(255, 255, 255, 0.04);
        --surface-hover: rgba(255, 255, 255, 0.07);
        --border: rgba(255, 255, 255, 0.1);
        --text-primary: #f0ede8;
        --text-muted: #8a8a9a;
        --google-red: #e8453c;
        --facebook-blue: #4a7fbd;
    }

    html, body {
        height: 100%;
        width: 100%;
        overflow-x: hidden;
    }

    body {
        font-family: 'Inter', sans-serif;
        background: #080c14;
        color: var(--text-primary);
        min-height: 100vh;
        position: relative;
    }

    .starfield {
        position: fixed;
        inset: 0;
        z-index: 0;
        overflow: hidden;
    }

    .starfield::before,
    .starfield::after {
        content: '';
        position: absolute;
        inset: -50%;
        width: 200%;
        height: 200%;
        background-image:
            radial-gradient(1px 1px at 10% 20%, rgba(255,255,255,0.6) 0%, transparent 100%),
            radial-gradient(1px 1px at 30% 70%, rgba(255,255,255,0.5) 0%, transparent 100%),
            radial-gradient(1px 1px at 55% 15%, rgba(255,255,255,0.7) 0%, transparent 100%),
            radial-gradient(1px 1px at 75% 45%, rgba(255,255,255,0.4) 0%, transparent 100%),
            radial-gradient(1px 1px at 90% 80%, rgba(255,255,255,0.6) 0%, transparent 100%),
            radial-gradient(1px 1px at 20% 90%, rgba(255,255,255,0.5) 0%, transparent 100%),
            radial-gradient(1px 1px at 45% 55%, rgba(200,169,110,0.4) 0%, transparent 100%),
            radial-gradient(1px 1px at 65% 30%, rgba(255,255,255,0.3) 0%, transparent 100%),
            radial-gradient(2px 2px at 15% 50%, rgba(200,169,110,0.3) 0%, transparent 100%),
            radial-gradient(1px 1px at 85% 10%, rgba(255,255,255,0.5) 0%, transparent 100%),
            radial-gradient(1px 1px at 35% 35%, rgba(255,255,255,0.4) 0%, transparent 100%),
            radial-gradient(1px 1px at 70% 65%, rgba(126,184,212,0.3) 0%, transparent 100%),
            radial-gradient(1px 1px at 5%  75%, rgba(255,255,255,0.5) 0%, transparent 100%),
            radial-gradient(1px 1px at 95% 55%, rgba(255,255,255,0.4) 0%, transparent 100%),
            radial-gradient(1px 1px at 50% 85%, rgba(200,169,110,0.3) 0%, transparent 100%);
        animation: drift 80s linear infinite;
    }

    .starfield::after {
        background-image:
            radial-gradient(1px 1px at 25% 10%, rgba(255,255,255,0.5) 0%, transparent 100%),
            radial-gradient(1px 1px at 60% 40%, rgba(255,255,255,0.6) 0%, transparent 100%),
            radial-gradient(2px 2px at 80% 20%, rgba(200,169,110,0.4) 0%, transparent 100%),
            radial-gradient(1px 1px at 40% 60%, rgba(255,255,255,0.3) 0%, transparent 100%),
            radial-gradient(1px 1px at 10% 40%, rgba(126,184,212,0.4) 0%, transparent 100%),
            radial-gradient(1px 1px at 90% 70%, rgba(255,255,255,0.5) 0%, transparent 100%);
        animation: drift 120s linear infinite reverse;
        opacity: 0.6;
    }

    @@keyframes drift {
        from { transform: translateX(0) translateY(0); }
        to   { transform: translateX(-5%) translateY(-8%); }
    }

    .bg-glow {
        position: fixed;
        inset: 0;
        z-index: 1;
        background:
            radial-gradient(ellipse 80% 60% at 50% 110%, rgba(40, 60, 100, 0.7) 0%, transparent 70%),
            radial-gradient(ellipse 60% 40% at 20% -10%, rgba(60, 40, 80, 0.4) 0%, transparent 60%),
            radial-gradient(ellipse 50% 50% at 80% 0%,   rgba(30, 60, 90, 0.35) 0%, transparent 60%);
        pointer-events: none;
    }

    .fog-layer {
        position: fixed;
        inset: 0;
        z-index: 2;
        pointer-events: none;
    }

    .fog-1 {
        background: radial-gradient(ellipse 140% 80% at 50% 120%, rgba(180, 210, 240, 0.12) 0%, rgba(140, 170, 210, 0.07) 30%, transparent 70%);
        animation: fogFloat1 18s ease-in-out infinite alternate;
    }

    .fog-2 {
        background: radial-gradient(ellipse 100% 60% at 10% 90%, rgba(200, 169, 110, 0.07) 0%, rgba(160, 130, 90, 0.04) 40%, transparent 70%);
        animation: fogFloat2 25s ease-in-out infinite alternate;
    }

    .fog-3 {
        background: radial-gradient(ellipse 120% 70% at 90% 80%, rgba(126, 184, 212, 0.06) 0%, transparent 60%);
        animation: fogFloat3 20s ease-in-out infinite alternate;
    }

    .fog-4 {
        background: radial-gradient(ellipse 200% 50% at 50% 100%, rgba(255, 255, 255, 0.04) 0%, rgba(200, 210, 230, 0.03) 30%, transparent 60%);
        animation: fogFloat4 30s ease-in-out infinite alternate;
    }

    .fog-wisps {
        position: fixed;
        inset: 0;
        z-index: 2;
        pointer-events: none;
        overflow: hidden;
    }

    .wisp {
        position: absolute;
        border-radius: 50%;
        filter: blur(40px);
        opacity: 0;
        animation: wispDrift var(--dur) ease-in-out infinite;
        animation-delay: var(--delay);
    }

    .wisp-1  { width: 300px; height: 120px; background: rgba(180,210,240,0.08); bottom: 5%;  left: -10%; --dur: 22s; --delay: 0s; }
    .wisp-2  { width: 400px; height: 150px; background: rgba(200,169,110,0.06); bottom: 10%; left: 20%;  --dur: 30s; --delay: -8s; }
    .wisp-3  { width: 350px; height: 130px; background: rgba(160,180,220,0.07); bottom: 3%;  left: 50%;  --dur: 25s; --delay: -15s; }
    .wisp-4  { width: 250px; height: 100px; background: rgba(200,169,110,0.05); bottom: 8%;  left: 70%;  --dur: 18s; --delay: -5s; }
    .wisp-5  { width: 500px; height: 180px; background: rgba(140,170,210,0.05); bottom: 0%;  left: -5%;  --dur: 35s; --delay: -20s; }

    @@keyframes fogFloat1 { from { transform: translate(-3%, 2%) scale(1); opacity: 1; } to { transform: translate(3%, -3%) scale(1.05); opacity: 0.85; } }
    @@keyframes fogFloat2 { from { transform: translate(2%, 3%) scale(1.02); opacity: 1; } to { transform: translate(-4%, 0%) scale(0.98); opacity: 0.7; } }
    @@keyframes fogFloat3 { from { transform: translate(-2%, 4%) scale(1); opacity: 1; } to { transform: translate(4%, -2%) scale(1.03); opacity: 0.8; } }
    @@keyframes fogFloat4 { from { transform: translateY(0) scale(1); opacity: 1; } to { transform: translateY(-3%) scale(1.04); opacity: 0.6; } }
    @@keyframes wispDrift { 0% { opacity: 0; transform: translateX(0) scaleY(1); } 20% { opacity: 1; } 80% { opacity: 0.8; } 100% { opacity: 0; transform: translateX(120px) scaleY(1.1); } }

    .page-wrapper {
        position: relative;
        z-index: 10;
        min-height: 100vh;
        display: grid;
        grid-template-columns: 1fr 1fr;
    }

    .brand-panel {
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: flex-start;
        padding: 80px 60px 80px 80px;
        position: relative;
    }

    .brand-panel::after {
        content: '';
        position: absolute;
        right: 0;
        top: 10%;
        height: 80%;
        width: 1px;
        background: linear-gradient(to bottom, transparent, rgba(200,169,110,0.3) 30%, rgba(200,169,110,0.3) 70%, transparent);
    }

    .brand-logo-wrap {
        margin-bottom: 48px;
    }

    .brand-sigil {
        width: 64px;
        height: 64px;
        margin-bottom: 20px;
        position: relative;
    }

    .brand-sigil svg {
        width: 100%;
        height: 100%;
        filter: drop-shadow(0 0 12px var(--primary-glow));
    }

    .brand-name {
        font-family: 'Cinzel', serif;
        font-size: 4.2rem;
        font-weight: 900;
        line-height: 1;
        letter-spacing: 8px;
        text-transform: uppercase;
        text-shadow: 0 0 15px rgba(255, 255, 255, 0.5);
        margin-bottom: 10px;
        background: linear-gradient(135deg, #f0e6cc 0%, #c8a96e 40%, #e8d5a8 60%, #a07840 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        filter: drop-shadow(0 0 30px rgba(200,169,110,0.5));
        animation: titlePulse 4s ease-in-out infinite;
        position: relative;
    }

    .brand-name::after {
        content: 'ẨN TRÌNH';
        position: absolute;
        inset: 0;
        background: linear-gradient(135deg, #f0e6cc 0%, #c8a96e 40%, #e8d5a8 60%, #a07840 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        filter: blur(20px);
        opacity: 0.4;
        z-index: -1;
    }

    @@keyframes titlePulse {
        0%, 100% { filter: drop-shadow(0 0 20px rgba(200,169,110,0.4)); }
        50% { filter: drop-shadow(0 0 40px rgba(200,169,110,0.7)); }
    }

    .brand-tagline {
        font-family: 'Inter', sans-serif;
        font-size: 0.85rem;
        font-weight: 300;
        letter-spacing: 4px;
        text-transform: uppercase;
        color: var(--accent);
        margin-top: 8px;
        opacity: 0.8;
    }

    .brand-divider {
        width: 80px;
        height: 1px;
        background: linear-gradient(to right, var(--primary), transparent);
        margin: 40px 0;
    }

    .brand-description {
        font-size: 1.05rem;
        line-height: 1.9;
        color: rgba(240,237,232,0.65);
        max-width: 380px;
        font-weight: 300;
    }

    .brand-description em {
        color: var(--primary);
        font-style: normal;
        font-weight: 500;
    }

    .brand-features {
        margin-top: 48px;
        display: flex;
        flex-direction: column;
        gap: 20px;
    }

    .feature-item {
        display: flex;
        align-items: center;
        gap: 14px;
        color: rgba(240,237,232,0.55);
        font-size: 0.9rem;
        letter-spacing: 0.5px;
    }

    .feature-dot {
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: var(--primary);
        box-shadow: 0 0 8px var(--primary-glow);
        flex-shrink: 0;
    }

    .auth-panel {
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        padding: 60px 60px 60px 80px;
    }

    .auth-card {
        width: 100%;
        max-width: 420px;
        background: rgba(255,255,255,0.03);
        backdrop-filter: blur(24px) saturate(150%);
        border: 1px solid rgba(255,255,255,0.09);
        border-radius: 24px;
        padding: 44px 40px;
        box-shadow: 0 0 0 1px rgba(200,169,110,0.08), 0 30px 80px rgba(0,0,0,0.5), 0 0 60px rgba(200,169,110,0.04) inset;
        position: relative;
        overflow: hidden;
    }

    .auth-card::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        height: 1px;
        background: linear-gradient(90deg, transparent, rgba(200,169,110,0.5), transparent);
    }

    .auth-tabs {
        display: flex;
        gap: 4px;
        background: rgba(255,255,255,0.04);
        border-radius: 12px;
        padding: 4px;
        margin-bottom: 32px;
    }

    .tab-btn {
        flex: 1;
        padding: 10px;
        border: none;
        border-radius: 9px;
        background: transparent;
        color: var(--text-muted);
        font-family: 'Inter', sans-serif;
        font-size: 0.88rem;
        font-weight: 500;
        cursor: pointer;
        transition: all 0.3s ease;
        letter-spacing: 0.5px;
    }

    .tab-btn.active {
        background: rgba(200,169,110,0.15);
        color: var(--primary);
        box-shadow: 0 0 20px rgba(200,169,110,0.1);
    }

    .tab-btn:hover:not(.active) {
        color: rgba(240,237,232,0.7);
        background: rgba(255,255,255,0.04);
    }

    .tab-content { display: none; }
    .tab-content.active { display: block; }

    .form-group {
        margin-bottom: 18px;
        position: relative;
    }

    .form-label {
        display: block;
        font-size: 0.78rem;
        font-weight: 500;
        letter-spacing: 1.5px;
        text-transform: uppercase;
        color: var(--text-muted);
        margin-bottom: 8px;
    }

    .form-control {
        width: 100%;
        margin: 15px 0;
        border-radius: 25px;
        padding: 13px 16px;
        background: rgba(255,255,255,0.05);
        border: 1px solid rgba(255,255,255,0.1);
        border-radius: 12px;
        color: var(--text-primary);
        font-family: 'Inter', sans-serif;
        font-size: 0.95rem;
        outline: none;
        transition: all 0.3s ease;
    }

    .form-control::placeholder { color: rgba(138,138,154,0.6); }

    .form-control:focus {
        border-color: rgba(200,169,110,0.5);
        background: rgba(255,255,255,0.07);
        box-shadow: 0 0 0 3px rgba(200,169,110,0.1), 0 0 20px rgba(200,169,110,0.05);
    }

    .input-icon-wrap { position: relative; }
    .input-icon-wrap .form-control { padding-left: 44px; }

    .input-icon {
        position: absolute;
        left: 14px;
        top: 50%;
        transform: translateY(-50%);
        color: var(--text-muted);
        font-size: 1rem;
        pointer-events: none;
    }

    .form-options {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 24px;
        margin-top: -4px;
    }

    .remember-wrap {
        display: flex;
        align-items: center;
        gap: 8px;
        cursor: pointer;
    }

    .remember-wrap input[type="checkbox"] {
        width: 16px;
        height: 16px;
        accent-color: var(--primary);
        cursor: pointer;
    }

    .remember-wrap span {
        font-size: 0.82rem;
        color: var(--text-muted);
    }

    .forgot-link {
        font-size: 0.82rem;
        color: var(--primary);
        text-decoration: none;
        opacity: 0.8;
        transition: opacity 0.2s;
    }

    .forgot-link:hover { opacity: 1; text-decoration: underline; }

    .btn-primary-auth {
        width: 100%;
        padding: 14px;
        border: none;
        font-weight: bold;
        border-radius: 12px;
        background: linear-gradient(135deg, #c8a96e 0%, #a07840 100%);
        color: #1a1208;
        font-family: 'Inter', sans-serif;
        font-size: 0.95rem;
        font-weight: 700;
        letter-spacing: 1px;
        cursor: pointer;
        transition: all 0.3s ease;
        position: relative;
        overflow: hidden;
    }
    
    .btn-primary-auth::before {
        content: '';
        position: absolute;
        inset: 0;
        background: linear-gradient(135deg, rgba(255,255,255,0.15) 0%, transparent 100%);
        opacity: 0;
        transition: opacity 0.3s;
    }

    .btn-primary-auth:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 30px rgba(200,169,110,0.4), 0 0 60px rgba(200,169,110,0.15);
    }

    .btn-primary-auth:hover::before { opacity: 1; }
    .btn-primary-auth:active { transform: translateY(0); }

    .auth-divider {
        display: flex;
        align-items: center;
        gap: 14px;
        margin: 24px 0;
        color: var(--text-muted);
        font-size: 0.78rem;
        letter-spacing: 2px;
        text-transform: uppercase;
    }

    .auth-divider::before,
    .auth-divider::after {
        content: '';
        flex: 1;
        height: 1px;
        background: rgba(255,255,255,0.08);
    }

    .social-buttons {
        display: flex;
        flex-direction: column;
        gap: 12px;
    }

    .btn-social {
        width: 100%;
        padding: 13px 16px;
        border: 1px solid rgba(255,255,255,0.1);
        border-radius: 12px;
        background: rgba(255,255,255,0.04);
        color: var(--text-primary);
        font-family: 'Inter', sans-serif;
        font-size: 0.9rem;
        font-weight: 500;
        cursor: pointer;
        transition: all 0.3s ease;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 12px;
        letter-spacing: 0.3px;
    }

    .btn-social:hover {
        background: rgba(255,255,255,0.08);
        border-color: rgba(255,255,255,0.18);
        transform: translateY(-2px);
        box-shadow: 0 6px 20px rgba(0,0,0,0.3);
    }

    .btn-social svg { width: 20px; height: 20px; flex-shrink: 0; }

    .btn-anon {
        width: 100%;
        padding: 13px 16px;
        border: 1px solid rgba(200,169,110,0.25);
        border-radius: 12px;
        background: rgba(200,169,110,0.06);
        color: var(--primary);
        font-family: 'Inter', sans-serif;
        font-size: 0.9rem;
        font-weight: 500;
        cursor: pointer;
        transition: all 0.3s ease;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        letter-spacing: 0.5px;
        margin-top: 12px;
    }

    .btn-anon:hover {
        background: rgba(200,169,110,0.12);
        border-color: rgba(200,169,110,0.45);
        transform: translateY(-2px);
        box-shadow: 0 6px 24px rgba(200,169,110,0.15);
    }

    .password-strength {
        display: flex;
        gap: 4px;
        margin-top: 8px;
    }

    .strength-bar {
        flex: 1;
        height: 3px;
        border-radius: 2px;
        background: rgba(255,255,255,0.1);
        transition: background 0.3s;
    }

    .terms-text {
        font-size: 0.75rem;
        color: var(--text-muted);
        text-align: center;
        margin-top: 16px;
        line-height: 1.6;
    }

    .terms-text a { color: var(--primary); text-decoration: none; opacity: 0.8; }
    .terms-text a:hover { opacity: 1; }
    
    .auth-footer {
        text-align: center;
        margin-top: 28px;
        font-size: 0.82rem;
        color: var(--text-muted);
    }

    @@media (max-width: 900px) {
        .page-wrapper { grid-template-columns: 1fr; }
        .brand-panel { display: none; }
        .auth-panel { padding: 40px 24px; min-height: 100vh; }
        .auth-card { max-width: 100%; }
        .brand-name { font-size: 2.5rem; }
    }

    .mobile-brand {
        display: none;
        text-align: center;
        margin-bottom: 32px;
    }

    @@media (max-width: 900px) {
        .mobile-brand { display: block; }
    }

    .mobile-brand-name {
        font-family: 'Cinzel', serif;
        font-size: 2.6rem;
        font-weight: 900;
        letter-spacing: 6px;
        background: linear-gradient(135deg, #f0e6cc 0%, #c8a96e 40%, #e8d5a8 60%, #a07840 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        filter: drop-shadow(0 0 20px rgba(200,169,110,0.5));
    }

    .mobile-brand-tagline {
        font-size: 0.75rem;
        letter-spacing: 3px;
        color: var(--accent);
        margin-top: 4px;
        text-transform: uppercase;
    }

    .auth-card { animation: cardIn 0.8s cubic-bezier(0.16, 1, 0.3, 1) both; }

    @@keyframes cardIn {
        from { opacity: 0; transform: translateY(30px) scale(0.97); }
        to { opacity: 1; transform: translateY(0) scale(1); }
    }

    .brand-panel > * { animation: brandIn 1s cubic-bezier(0.16, 1, 0.3, 1) both; }
    .brand-panel > *:nth-child(1) { animation-delay: 0.1s; }
    .brand-panel > *:nth-child(2) { animation-delay: 0.2s; }
    .brand-panel > *:nth-child(3) { animation-delay: 0.3s; }
    .brand-panel > *:nth-child(4) { animation-delay: 0.4s; }

    @@keyframes brandIn {
        from { opacity: 0; transform: translateX(-20px); }
        to   { opacity: 1; transform: translateX(0); }
    }
</style>

<!-- Backgrounds -->
<div class="starfield"></div>
<div class="bg-glow"></div>

<!-- Fog layers -->
<div class="fog-layer fog-1"></div>
<div class="fog-layer fog-2"></div>
<div class="fog-layer fog-3"></div>
<div class="fog-layer fog-4"></div>

<!-- Wispy fog particles -->
<div class="fog-wisps">
    <div class="wisp wisp-1"></div>
    <div class="wisp wisp-2"></div>
    <div class="wisp wisp-3"></div>
    <div class="wisp wisp-4"></div>
    <div class="wisp wisp-5"></div>
</div>

<!-- Main layout -->
<div class="page-wrapper">
    <!-- Left: Branding -->
    <div class="brand-panel">
        <div class="brand-logo-wrap">
            <div class="brand-sigil">
                <svg viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <circle cx="32" cy="32" r="30" stroke="url(#g1)" stroke-width="1.5" stroke-dasharray="4 3"/>
                    <circle cx="32" cy="32" r="20" stroke="url(#g2)" stroke-width="1"/>
                    <circle cx="32" cy="32" r="4" fill="url(#g3)"/>
                    <path d="M32 2 L32 12 M32 52 L32 62 M2 32 L12 32 M52 32 L62 32" stroke="url(#g1)" stroke-width="1.5" stroke-linecap="round"/>
                    <path d="M32 12 Q44 24 32 32 Q20 40 32 52" stroke="url(#g2)" stroke-width="1" fill="none"/>
                    <defs>
                        <linearGradient id="g1" x1="0" y1="0" x2="64" y2="64" gradientUnits="userSpaceOnUse">
                            <stop stop-color="#f0e6cc"/>
                            <stop offset="1" stop-color="#a07840"/>
                        </linearGradient>
                        <linearGradient id="g2" x1="0" y1="0" x2="64" y2="64" gradientUnits="userSpaceOnUse">
                            <stop stop-color="#7eb8d4"/>
                            <stop offset="1" stop-color="#4a8aaa"/>
                        </linearGradient>
                        <radialGradient id="g3" cx="50%" cy="50%" r="50%">
                            <stop stop-color="#f0e6cc"/>
